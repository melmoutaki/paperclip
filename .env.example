DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Telemetry & outbound network (DAAS fork) ---
# Telemetry and feedback-trace sharing are DISABLED by default in this fork.
# No values below are secrets; leave them commented to keep outbound traffic off.
# See docs/deploy/outbound-network.md for the full list of outbound connectors.

# Opt in to anonymous product telemetry (default: off).
# PAPERCLIP_TELEMETRY_ENABLED=1
# Hard kill switches (force telemetry off even if opted in elsewhere).
# PAPERCLIP_TELEMETRY_DISABLED=1
# DO_NOT_TRACK=1
# Enterprise policy: when set to an enforce value, enabling telemetry fails closed.
# PAPERCLIP_ENTERPRISE_TELEMETRY_POLICY=enforce_disabled

# Opt in to outbound feedback-trace sharing (default: off).
# PAPERCLIP_FEEDBACK_SHARING_ENABLED=1
